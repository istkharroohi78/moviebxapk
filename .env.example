create # ─── Telegram Bot ─────────────────────────────────────────────
API_ID=             # from https://my.telegram.org
API_HASH=           # from https://my.telegram.org
TELEGRAM_BOT_TOKEN= # from @BotFather

# ─── MongoDB ──────────────────────────────────────────────────
MONGODB_URI=        # mongodb+srv://user:pass@cluster.mongodb.net/dbname
COLLECTION_NAME=test

# ─── TMDB ─────────────────────────────────────────────────────
TMDB_API_KEY=       # from https://www.themoviedb.org/settings/api

# ─── Bot Channels ─────────────────────────────────────────────
INDEX_CHANNELS=     # comma-separated channel IDs e.g. -1001234567890
ADMINS=             # your Telegram user ID e.g. 123456789
LOG_CHANNEL=        # log channel ID e.g. -1001234567890

# ─── Website ──────────────────────────────────────────────────
WEBSITE_URL=        # your public domain e.g. https://mysite.com
VITE_BOT_USERNAME=  # bot username without @ e.g. MyMovieBot

# ─── Optional ports (defaults shown) ─────────────────────────
# API_PORT=5000
# WEB_PORT=3000
