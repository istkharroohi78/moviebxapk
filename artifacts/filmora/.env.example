# ─── Branding ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_NAME=FilmyWave
NEXT_PUBLIC_SITE_URL=https://filmywave.com
NEXT_PUBLIC_LOGO_PATH=/filmywave-logo.png

# ─── Contact ─────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=contact@filmywave.com

# ─── Social ──────────────────────────────────────────────────
NEXT_PUBLIC_TWITTER_HANDLE=@filmywave

# ─── Analytics & Verification ────────────────────────────────
# Get from Google Analytics → Data Streams → Measurement ID
NEXT_PUBLIC_GA_ID=
# Get from Google Search Console → Verify via HTML tag
NEXT_PUBLIC_GSC_VERIFICATION=

# ─── Download Proxy ──────────────────────────────────────────
# URL of a CORS proxy used for the download button
# e.g. https://yourworker.your-subdomain.workers.dev/api/proxy
NEXT_PUBLIC_DOWNLOAD_PROXY_URL=

# ─── Telegram Bot ────────────────────────────────────────────
# Your bot's username (without @) for deep links
NEXT_PUBLIC_BOT_USERNAME=

# ─── TMDB API ────────────────────────────────────────────────
TMDB_API_KEY=

# ─── Gmail OTP Login ─────────────────────────────────────────
# Gmail address that sends the login codes
GMAIL_USER=
# Google Account → Security → App passwords (16 chars, no spaces)
GMAIL_APP_PASSWORD=
# Random long string used to sign session cookies
AUTH_SECRET=

# ─── MongoDB (movie catalogue + users) ───────────────────────
MONGODB_URI=
MONGODB_DB=moviebox
