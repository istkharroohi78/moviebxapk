# ── Required ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_bot_token_here
API_ID=your_api_id          # from my.telegram.org
API_HASH=your_api_hash      # from my.telegram.org
MONGODB_URI=mongodb+srv://...

# ── Channels ──────────────────────────────────────────────────────────────────
INDEX_CHANNELS=-1001234567890,-1009876543210   # comma-separated channel IDs
REQUEST_CHANNEL=-1001234567890                  # where users request files
FILE_STORE_CHANNEL=-1001234567890              # private channel to store files
FORCE_SUB_CHANNEL=your_channel_username        # leave empty to disable

# ── Admins ────────────────────────────────────────────────────────────────────
ADMINS=123456789,987654321   # comma-separated admin user IDs

# ── TMDB ─────────────────────────────────────────────────────────────────────
TMDB_API_KEY=your_tmdb_api_key

# ── Features ──────────────────────────────────────────────────────────────────
AUTO_FILTER=True
MAX_RESULTS=10
IMDB=True
SPELL_CHECK=True

# ── Branding ─────────────────────────────────────────────────────────────────
BOT_NAME=FilmoraBot
WEBSITE_URL=https://your-domain.replit.app
CUSTOM_CAPTION=
